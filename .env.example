# Supabase — copy to .env.local and fill in your project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site
# MOET het hostname bevatten waarop de site echt draait, inclusief www.
# Deze var voedt twee dingen tegelijk: elke canonical en elke sitemap-URL, en de
# canonieke host in src/middleware.ts. Staat hier het kale domein terwijl de site
# op www draait, dan stempelt de middleware `X-Robots-Tag: noindex, nofollow` op
# élke pagina van de live site. De middleware negeert sinds kort het
# www-verschil, maar de canonicals volgen deze waarde nog steeds letterlijk —
# dus zet hem gelijk aan het domein in de browser.
NEXT_PUBLIC_SITE_URL=https://www.ibizamivida.com
NEXT_PUBLIC_WHATSAPP_NUMBER=33666528412

# Cloudinary — media delivery (4K video + images load instantly from Cloudinary)
# Find these in your Cloudinary dashboard: Settings → API Keys (or the top of
# the dashboard "Product Environment Credentials" box).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=nd941t40
CLOUDINARY_CLOUD_NAME=nd941t40
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Alternatively provide a single URL (used by the media-upload script):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@nd941t40
#
# Migrate all hero/background clips into your cloud (one-time):
#   npm run upload-media
#
# Optional: override the homepage hero clips (comma-separated public ids/URLs).
# NEXT_PUBLIC_HOME_HERO_VIDEOS=ibiza-mi-vida/home/anyma-1,ibiza-mi-vida/home/anyma-2

# Instagram feed (homepage "Ibiza op je feed" section) — LIVE real posts.
# Instagram can't be scraped server-side (login wall + expiring CDN URLs), so
# point this at a feed-provider JSON endpoint that stays fresh:
#   1) Behold.so (free): create a feed for @ibizamivida, copy its JSON URL here.
#   2) Or your own Instagram Graph API proxy returning [{ mediaUrl, permalink }].
# When unset, the section shows a tasteful fallback grid.
# NEXT_PUBLIC_INSTAGRAM_FEED_URL=https://feeds.behold.so/XXXXXXXX

# Sentry — crash monitoring (client + server + edge). Without a DSN, Sentry is
# fully disabled everywhere (see sentry.*.config.ts) — zero effect, zero risk.
# To turn it on: create a free account at https://sentry.io, create a Next.js
# project, and paste its DSN below (same value for both — the server one lets
# server/edge code report too, even without exposing it to the browser).
#   1) sentry.io → New Project → Next.js → copy the DSN it gives you
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@o000000.ingest.us.sentry.io/0000000
# SENTRY_DSN=https://xxxxxxxx@o000000.ingest.us.sentry.io/0000000
#
# Optional — only needed for readable stack traces (sourcemap upload) in the
# Sentry dashboard. Find these under Settings → Auth Tokens in your Sentry org.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=your-auth-token

# Google reviews (about-us page) — REAL reviews from our Google Business
# Profile via the Places API (New). When either variable is empty the whole
# integration is a no-op: no request is made and the reviews section and its
# AggregateRating markup are not rendered at all. That is deliberate — we never
# show placeholder or sample reviews. Leave these blank until the Business
# Profile is verified and has real reviews.
#   1) GOOGLE_PLACES_API_KEY — Google Cloud console (console.cloud.google.com):
#      create/select a project → APIs & Services → Library → enable
#      "Places API (New)" → Credentials → Create credentials → API key.
#      Restrict it to the Places API. Billing must be enabled; calls are billed
#      per request, which is why the response is cached for 24h.
#   2) GOOGLE_PLACE_ID — the Place ID of the business listing. Get it from the
#      Place ID Finder (developers.google.com/maps/documentation/places/web-service/place-id)
#      by searching the business name, or from the business's Google Maps
#      listing URL. Looks like ChIJxxxxxxxxxxxxxxxxxxxxxxx.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
