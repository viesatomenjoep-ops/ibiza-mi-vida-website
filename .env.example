# Supabase — copy to .env.local and fill in your project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site
NEXT_PUBLIC_SITE_URL=https://ibizamivida.com
NEXT_PUBLIC_WHATSAPP_NUMBER=34XXXXXXXXX

# Cloudinary — media delivery (4K video + images load instantly from Cloudinary)
# Find these in your Cloudinary dashboard: Settings → API Keys (or the top of
# the dashboard "Product Environment Credentials" box).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=daj1lyfgk
CLOUDINARY_CLOUD_NAME=daj1lyfgk
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Optional: serve the homepage hero clips from Cloudinary instead of local mp4s.
# Comma-separated Cloudinary public ids or full delivery URLs.
# NEXT_PUBLIC_HOME_HERO_VIDEOS=home/anyma-1,home/anyma-2,home/calvin
